<?xml version="1.0" encoding="utf-8"?>
<!-- A queue card: a catalogue card, whiter than the paper under it, with a slightly darker edge.
     It also gives the card its outline (for the shadow and for clipping). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainer" />
    <corners android:radius="@dimen/radius_card" />
</shape>
