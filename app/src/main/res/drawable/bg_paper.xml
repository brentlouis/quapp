<?xml version="1.0" encoding="utf-8"?>
<!-- The screen ground: paper with the aged texture tiled on top.
     Set as android:windowBackground, so every Activity gets it. The pinned headers on Browse and
     Your queues use it too, so no darkened edges here: they would show as bands at the header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/paper" />
</shape>
