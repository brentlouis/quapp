<?xml version="1.0" encoding="utf-8"?>
<!-- A hairline above and below, nothing else: frames a before/after pair ("Now closes · Will close"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="@dimen/hairline">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="@dimen/hairline">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
