<?xml version="1.0" encoding="utf-8"?>
<!-- A faded card (Paused, Closed): no fill, a dashed outline edge (DESIGN.md "Queue card") -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/hairline"
        android:color="?attr/colorOutline"
        android:dashWidth="@dimen/tear_line_dash"
        android:dashGap="@dimen/tear_line_dash" />
    <corners android:radius="@dimen/radius_md" />
</shape>
