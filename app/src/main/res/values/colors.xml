<?xml version="1.0" encoding="utf-8"?>
<!-- Civic Paper tokens. DESIGN.md section 2 says where each one is used.
     Layouts use ?attr/ roles; these are referenced directly only by the theme,
     the status colours, crema tear lines and signal (inside the spotlight). -->
<resources>
    <!-- Civic Paper Evolution: teal action, espresso identity, warm neutral surfaces. -->
    <color name="primary">#2DBBAE</color>
    <color name="on_primary">#0F2220</color>
    <color name="primary_container">#DFF1EC</color>
    <color name="on_primary_container">#0B4F4A</color>
    <color name="primary_text">#0B4F4A</color>
    <!-- Paper -->
    <color name="paper">#EEF6F4</color>
    <color name="paper_raised">#FFFFFF</color>
    <color name="paper_sunk">#E2F0EC</color>
    <!-- Queue cards: catalogue card stock, whiter than paper_raised so it lifts off the ground -->
    <color name="index_card">#FFFFFF</color>
    <color name="index_card_edge">#CADCD7</color>
    <!-- The ruled lines on a card: roast at 16% -->
    <color name="index_card_rule">#CADCD7</color>
    <color name="index_card_hole_rim">#CADCD7</color>
    <color name="line">#CADCD7</color>
    <color name="outline">#48605C</color>

    <!-- Ink -->
    <color name="ink">#0F2220</color>
    <color name="ink_muted">#48605C</color>
    <color name="ink_faint">#48605C</color>

    <!-- The spotlight: the one espresso ticket per screen -->
    <color name="spotlight">#0B4F4A</color>
    <color name="on_spotlight">#FFFFFF</color>
    <color name="on_spotlight_muted">#DFF1EC</color>
    <color name="spotlight_line">#0B4F4A</color>

    <!-- Coffee accents -->
    <color name="crema">#CADCD7</color>
    <color name="roast">#0B4F4A</color>

    <!-- Signal (marigold): only on the spotlight, only for called / now serving -->
    <color name="signal">#F5B83D</color>
    <color name="on_signal">#0F2220</color>

    <!-- Status on paper -->
    <color name="ok">#2F6B47</color>
    <color name="ok_soft">#DCEAD9</color>
    <color name="warn">#80590C</color>
    <color name="warn_soft">#F1E5C8</color>
    <color name="err">#B3261E</color>
    <color name="err_soft">#F6DCD8</color>
    <color name="on_err">#FFFFFF</color>

    <!-- Status on the spotlight (lighter so they read on espresso) -->
    <color name="ok_on_spotlight">#9FD9B0</color>
    <color name="warn_on_spotlight">#E9C77E</color>
    <color name="err_on_spotlight">#F2A69C</color>

    <!-- Ticket status, kept as names so existing screens compile until they are rebuilt.
         Waiting is neutral; Called is the spotlight. -->
    <color name="status_waiting">@color/ink_muted</color>
    <color name="status_called">@color/spotlight</color>
    <color name="status_served">@color/ok</color>
    <color name="status_expired">@color/err</color>
</resources>
