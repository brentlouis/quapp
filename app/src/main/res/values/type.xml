<?xml version="1.0" encoding="utf-8"?>
<!-- Civic Paper type (DESIGN.md section 3). Layouts never set textSize: they point at these
     through ?attr/textAppearance… roles mapped in themes.xml.

     Each style names the exact font file for its weight. Picking 500/600 out of a font family
     only works on API 28+, and min SDK is 24.
     fontFamily (app) is read by AppCompat below API 26; android:fontFamily on 26+. -->
<resources>

    <!-- ===== DM Serif Display: headlines and numbers that name a ticket. Never below 20sp, never bold. ===== -->

    <style name="TextAppearance.Quapp.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_29_sp</item>
        <item name="lineHeight">@dimen/type_36_sp</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.Quapp.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_24_sp</item>
        <item name="lineHeight">@dimen/type_29_sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Quapp.TicketNumber" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">sans-serif-condensed</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_56_sp</item>
        <item name="lineHeight">@dimen/type_53_sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Quapp.TicketNumber.Called">
        <item name="android:textSize">@dimen/type_132_sp</item>
        <item name="lineHeight">@dimen/type_119_sp</item>
    </style>

    <!-- The counter display (canvas 32): read from across a waiting room -->
    <style name="TextAppearance.Quapp.TicketNumber.Counter">
        <item name="android:textSize">@dimen/type_160_sp</item>
        <item name="lineHeight">@dimen/type_144_sp</item>
    </style>

    <!-- ===== IBM Plex Sans: everything read ===== -->

    <style name="TextAppearance.Quapp.HeadingSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_17_sp</item>
        <item name="lineHeight">@dimen/type_21_sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- List primaries and card titles on paper -->
    <style name="TextAppearance.Quapp.ListPrimary" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_20_sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Quapp.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_24_sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Quapp.BodyStrong" parent="TextAppearance.Quapp.Body">
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_24_sp</item>
    </style>

    <style name="TextAppearance.Quapp.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_22_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Quapp.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_20_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bottom-nav labels and chip counts -->
    <style name="TextAppearance.Quapp.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_20_sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== IBM Plex Mono: data. Anything that counts or ticks. ===== -->

    <style name="TextAppearance.Quapp.Stat" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_22_sp</item>
        <item name="lineHeight">@dimen/type_24_sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Quapp.StatHero" parent="TextAppearance.Quapp.Stat">
        <item name="android:textSize">@dimen/type_26_sp</item>
        <item name="lineHeight">@dimen/type_29_sp</item>
    </style>

    <!-- Status pills, section labels ("IN TAGBILARAN CITY · 4"), stat labels -->
    <style name="TextAppearance.Quapp.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_20_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Field labels, above the box -->
    <style name="TextAppearance.Quapp.FieldLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_18_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- What you type into a field -->
    <style name="TextAppearance.Quapp.Input" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_21_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- Mono tallies at the small and display ends: slip values, and the big wait on Insights -->
    <style name="TextAppearance.Quapp.StatSmall" parent="TextAppearance.Quapp.Stat">
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_18_sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Quapp.StatDisplay" parent="TextAppearance.Quapp.Stat">
        <item name="android:textSize">@dimen/type_56_sp</item>
        <item name="lineHeight">@dimen/type_56_sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <!-- "I'm here": the one 64dp button -->
    <style name="TextAppearance.Quapp.Button.Call">
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/type_18_sp</item>
        <item name="lineHeight">@dimen/type_22_sp</item>
    </style>
    <!-- Rubber stamp: mono caps, widely tracked -->
    <style name="TextAppearance.Quapp.Stamp" parent="TextAppearance.Quapp.Label">
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <!-- The number you're about to be handed on Join (canvas 07) -->
    <style name="TextAppearance.Quapp.TicketNumber.Large">
        <item name="android:textSize">@dimen/type_112_sp</item>
        <item name="lineHeight">@dimen/type_104_sp</item>
    </style>

    <!-- The number on a kept ticket (canvas 22, 23) -->
    <style name="TextAppearance.Quapp.TicketNumber.Small">
        <item name="android:textSize">@dimen/type_44_sp</item>
        <item name="lineHeight">@dimen/type_44_sp</item>
    </style>
    <!-- Chip labels -->
    <style name="TextAppearance.Quapp.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Mono data that isn't a tally: a card's schedule ("Today · 8 AM – 4 PM"), masked phones -->
    <style name="TextAppearance.Quapp.MonoSmall" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/type_16_sp</item>
        <item name="lineHeight">@dimen/type_22_sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
