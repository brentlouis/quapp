<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Quapp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_40</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_90</item>
        <item name="colorOnPrimaryContainer">@color/teal_10</item>

        <item name="colorSecondary">@color/slate_40</item>

        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>

        <item name="colorOutline">@color/outline_light</item>
        <item name="colorError">@color/error_light</item>

        <item name="android:statusBarColor">@color/teal_40</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Quapp.Splash" parent="Theme.Quapp">
        <item name="android:windowBackground">@color/teal_40</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>