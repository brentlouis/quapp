<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ticket_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ImageButton
        android:id="@+id/ticket_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ticket_back_description"
        android:padding="@dimen/space_sm"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/ticket_queue_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_md"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toTopOf="@id/ticket_venue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ticket_back"
        app:layout_constraintTop_toTopOf="@id/ticket_back"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Barangay Relief Distribution" />

    <TextView
        android:id="@+id/ticket_venue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/ticket_back"
        app:layout_constraintEnd_toEndOf="@id/ticket_queue_name"
        app:layout_constraintStart_toStartOf="@id/ticket_queue_name"
        app:layout_constraintTop_toBottomOf="@id/ticket_queue_name"
        tools:text="Brgy. Poblacion Hall" />

    <!--
        The ticket itself. Fills the space between the header and the buttons, and
        takes its colors from the ticket's status (set in ActiveTicketActivity).
        Only the views for the current status are visible; the rest are gone.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticket_hero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_ticket_hero"
        android:padding="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/ticket_leave_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ticket_back"
        tools:backgroundTint="?attr/colorPrimaryContainer">

        <TextView
            android:id="@+id/ticket_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:layout_constraintBottom_toTopOf="@id/ticket_ahead"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Waiting" />

        <!-- Waiting: how many people are still ahead. -->
        <TextView
            android:id="@+id/ticket_ahead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceDisplayLarge"
            app:layout_constraintBottom_toTopOf="@id/ticket_ahead_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_status"
            tools:text="41" />

        <TextView
            android:id="@+id/ticket_ahead_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintBottom_toTopOf="@id/ticket_eta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_ahead"
            tools:text="@string/ticket_ahead_label" />

        <TextView
            android:id="@+id/ticket_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintBottom_toTopOf="@id/ticket_ring"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_ahead_label"
            tools:text="About 55 min" />

        <!-- Called: the grace period as a draining ring around the countdown. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ticket_ring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:max="1000"
            android:visibility="gone"
            app:indicatorSize="@dimen/ticket_ring_size"
            app:layout_constraintBottom_toTopOf="@id/ticket_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_eta"
            app:trackCornerRadius="@dimen/ticket_ring_thickness"
            app:trackThickness="@dimen/ticket_ring_thickness"
            tools:progress="700"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ticket_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceDisplayMedium"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ticket_ring"
            app:layout_constraintEnd_toEndOf="@id/ticket_ring"
            app:layout_constraintStart_toStartOf="@id/ticket_ring"
            app:layout_constraintTop_toTopOf="@id/ticket_ring"
            tools:text="02:47"
            tools:visibility="visible" />

        <!-- Served / expired: a plain-language outcome. -->
        <TextView
            android:id="@+id/ticket_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/ticket_instruction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_ring"
            tools:text="@string/ticket_served_headline" />

        <TextView
            android:id="@+id/ticket_instruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/ticket_number_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ticket_headline"
            tools:text="Confirm now or your slot is released." />

        <!-- The stub, pinned to the bottom: the number the counter will call out. -->
        <TextView
            android:id="@+id/ticket_number_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ticket_number_label"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            app:layout_constraintBottom_toTopOf="@id/ticket_number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/ticket_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="#43" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Waiting only. Leaving is secondary, so it never takes the filled style. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ticket_leave_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/ticket_leave_action"
        app:layout_constraintBottom_toTopOf="@id/ticket_primary_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/space_md" />

    <!-- Called: "I'm here". Served / expired: "Done". -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ticket_primary_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="I'm here" />

</androidx.constraintlayout.widget.ConstraintLayout>
