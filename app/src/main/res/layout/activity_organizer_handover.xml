<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/handover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/handover_scroll"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="@dimen/dimension_zero"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/handover_back"
            style="@style/Widget.Quapp.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analytics_back_description" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/handover_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />
        <TextView
            android:id="@+id/handover_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView
            android:id="@+id/handover_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:accessibilityLiveRegion="polite"
            android:text="@string/handover_unavailable"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/handover_unchanged"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/handover_retry"
            style="@style/Widget.Quapp.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/handover_retry" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/handover_transfer"
            style="@style/Widget.Quapp.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:enabled="false"
            android:text="@string/handover_transfer" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
