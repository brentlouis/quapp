<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab (canvas 10), on both homes. Plain paper: a settings list, no ticket details. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/profile_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- Who you are -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile_initials"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="MS" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_ms"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Maria Santos" />

                <TextView
                    android:id="@+id/profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="0917 123 4567" />
            </LinearLayout>
        </LinearLayout>

        <!-- Organizers only: verification pending (canvas 51), with what the limits are -->
        <LinearLayout
            android:id="@+id/profile_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_ms"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_ms"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/profile_pending_pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pill_height"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/paper_sunk"
                android:gravity="center"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="@string/profile_verification_pending"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/ink_muted" />

            <TextView
                android:id="@+id/profile_pending_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Submitted Sep 28. We'll call (038) 411 2345 to confirm." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/profile_verification_limits"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <!-- Your record (queuers only): two columns between hairlines -->
        <LinearLayout
            android:id="@+id/profile_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="vertical">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_ms"
                    android:paddingBottom="@dimen/space_ms">

                    <TextView
                        android:id="@+id/profile_served"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceStatHero"
                        tools:text="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_served_label"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="@dimen/hairline"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_ms"
                    android:paddingTop="@dimen/space_ms"
                    android:paddingBottom="@dimen/space_ms">

                    <TextView
                        android:id="@+id/profile_no_shows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceStatHero"
                        tools:text="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_no_shows_label"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Rows -->
        <include
            android:id="@+id/profile_history_row"
            layout="@layout/view_list_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/profile_history_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Organizers only: Get verified, or the badge once verified -->
        <include
            android:id="@+id/profile_verify_row"
            layout="@layout/view_list_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/profile_verify_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/profile_switch_row"
            layout="@layout/view_list_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/profile_help_row"
            layout="@layout/view_list_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/profile_logout_row"
            layout="@layout/view_list_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
