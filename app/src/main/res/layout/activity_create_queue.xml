<?xml version="1.0" encoding="utf-8"?>
<!-- Create / edit queue (canvas 14): three numbered sections (Basics, Schedule, Verification)
     on plain paper, "Create queue" in the dock. Pickers (municipality, category, dates, times)
     are select fields: they look like text boxes and open a dialog or sheet when tapped. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App bar -->
    <ImageButton
        android:id="@+id/create_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/create_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/create_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/create_back"
        app:layout_constraintTop_toTopOf="@id/create_back">

        <TextView
            android:id="@+id/create_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/create_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/create_subtitle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/create_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/create_tear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/create_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- Who the queue will say it's organized by -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_building"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/create_posting_as"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Posting as City Health Office" />

                <ImageView
                    android:id="@+id/create_posting_verified"
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/detail_verified"
                    android:src="@drawable/ic_badge_check"
                    app:tint="@color/ok" />
            </LinearLayout>

            <!-- ===== 1 · Basics ===== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/forgot_step_size"
                    android:layout_height="@dimen/forgot_step_size"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_1"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/create_section_basics"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/create_name_input"
                android:text="@string/create_name_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_name_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/create_name_placeholder"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/create_venue_input"
                android:text="@string/create_venue_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_venue_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_venue_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/create_venue_placeholder"
                    android:inputType="textCapWords|textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_municipality_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_municipality"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_category_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_category"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/create_pick_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/create_required_error"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/create_short_input"
                android:text="@string/create_short_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_short_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:counterEnabled="true"
                app:counterMaxLength="50"
                app:helperText="@string/create_short_helper"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_short_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/create_short_placeholder"
                    android:inputType="textCapSentences"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/create_details_input"
                android:text="@string/create_details_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_details_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_details_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/create_details_placeholder"
                    android:inputType="textCapSentences|textMultiLine"
                    android:gravity="top"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/create_bring_input"
                android:text="@string/create_bring_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_bring_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_bring_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/create_bring_placeholder"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== 2 · Schedule ===== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/forgot_step_size"
                    android:layout_height="@dimen/forgot_step_size"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_2"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/create_section_schedule"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/create_length_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_one_day"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_one_day" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_multiple_days"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_multiple_days" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/create_start_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_start_date_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_start_date"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_end_date_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_end_date"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_opens_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_opens"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_clock"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_closes_label"
                        android:textAppearance="?attr/textAppearanceFieldLabel" />

                    <TextView
                        android:id="@+id/create_closes"
                        style="@style/Widget.Quapp.SelectField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:drawableEnd="@drawable/ic_clock"
                        android:hint="@string/create_pick_placeholder" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/create_schedule_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- "2 days (Sep 27–28), 8 AM – 4 PM each day. …" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_ms"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_check"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/create_schedule_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="2 days (Sep 27–28), 8 AM – 4 PM each day. The queue opens and closes on its own." />
            </LinearLayout>

            <!-- ===== 3 · Verification ===== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/forgot_step_size"
                    android:layout_height="@dimen/forgot_step_size"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_3"
                    android:textAppearance="?attr/textAppearanceLabelSmall" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/create_section_verification"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_section_verification_lead"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle">

            <include
                android:id="@+id/create_toggle_grace"
                layout="@layout/view_verification_toggle" />

            <include
                android:id="@+id/create_toggle_penalty"
                layout="@layout/view_verification_toggle" />

            <include
                android:id="@+id/create_toggle_otp"
                layout="@layout/view_verification_toggle" />

            <include
                android:id="@+id/create_toggle_proximity"
                layout="@layout/view_verification_toggle" />

            </LinearLayout>

            <!-- Proximity on: how near, and where the venue is -->
            <LinearLayout
                android:id="@+id/create_proximity_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/create_radius_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/create_radius_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_radius_500"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_radius_500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_radius_1000"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_radius_1000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_radius_2000"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_radius_2000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_radius_5000"
                    style="@style/Widget.Quapp.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_radius_5000" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_ms"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_map_pin"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_ms"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_pin_label"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/create_pin_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            tools:text="Centre of Tagbilaran City" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Dock ===== -->

    <com.example.quapp.TearLineView
        android:id="@+id/create_tear"
        android:layout_width="0dp"
        android:layout_height="@dimen/tear_line_width"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintBottom_toTopOf="@id/create_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/create_dock"
        style="@style/Widget.Quapp.Dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_submit_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="@string/create_action" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
