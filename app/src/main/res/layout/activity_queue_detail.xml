<?xml version="1.0" encoding="utf-8"?>
<!-- Queue detail (canvas 06). The agreed exception to "one ticket detail per screen": the
     category as a serial line, the numbers on a receipt slip, and the tear-off stub dock where
     you're handed your number. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/detail_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/detail_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/detail_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- Serial line and status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.14"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Relief" />

                <TextView
                    android:id="@+id/detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/pill_height"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_sm"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    tools:backgroundTint="@color/ok_soft"
                    tools:text="Open"
                    tools:textColor="@color/ok" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_ms"
                android:accessibilityHeading="true"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                tools:text="Barangay Relief Distribution" />

            <!-- Where, with directions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_venue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Brgy. Poblacion Hall · Tagbilaran City" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_directions"
                    style="@style/Widget.Quapp.Button.Tonal.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ticket_directions_action"
                    app:icon="@drawable/ic_navigation" />
            </LinearLayout>

            <!-- The numbers: filled by ReceiptSlip -->
            <LinearLayout
                android:id="@+id/detail_slip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_note"
                android:divider="@drawable/divider_slip"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_xs"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_ms"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Distribution of family food packs for registered households." />

            <!-- Why you can't join right now (paused, already in line, cooldown) -->
            <TextView
                android:id="@+id/detail_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_note"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_ms"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_ms"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:text="You missed your slot too many times. Queues with a no-show cooldown open to you again in 28 min."
                tools:visibility="visible" />

            <!-- Verification checks, in their fixed order -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_verification_label"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle">

                <include
                    android:id="@+id/detail_rule_proximity"
                    layout="@layout/view_requirement" />

                <include
                    android:id="@+id/detail_rule_grace"
                    layout="@layout/view_requirement" />

                <include
                    android:id="@+id/detail_rule_penalty"
                    layout="@layout/view_requirement" />

                <include
                    android:id="@+id/detail_rule_otp"
                    layout="@layout/view_requirement" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Tear-off stub dock: your number to be, and Join ===== -->

    <LinearLayout
        android:id="@+id/detail_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.example.quapp.TearLineView
            android:layout_width="match_parent"
            android:layout_height="@dimen/tear_line_width"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md" />

        <LinearLayout
            style="@style/Widget.Quapp.Dock.Stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/detail_you_will_be"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_ms"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_you_will_be"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/detail_next_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    tools:text="#43" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_join_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_lg"
                android:layout_weight="2"
                android:text="@string/detail_join_action" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
