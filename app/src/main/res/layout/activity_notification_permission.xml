<?xml version="1.0" encoding="utf-8"?>
<!-- Notification permission (canvas 20), once, after the first join on Android 13+. The
     spotlight is a preview of the notification itself, so people see what they'd be allowing
     before Android's own dialog asks. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notify_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/notify_tear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- The preview: what the called notification looks like -->
            <LinearLayout
                android:id="@+id/notify_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/notify_preview_description"
                android:importantForAccessibility="yes"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:theme="@style/ThemeOverlay.Quapp.Spotlight">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/chip_icon_size"
                        android:layout_height="@dimen/chip_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_stat_quapp"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/notify_preview_app"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notify_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="You're being called · #43" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/notify_preview_text"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_ms"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <!-- Pictures of buttons: not clickable, the real ones are in the dock -->
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Quapp.Button.Call.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="@string/ticket_here_action" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Quapp.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="@string/notification_called_open_short"
                        android:textColor="@color/crema" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:accessibilityHeading="true"
                android:text="@string/notify_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:id="@+id/notify_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="When you're called, you have 3 minutes to confirm. Notifications let you tap &quot;I'm here&quot; without opening the app." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_note_warn"
                android:drawablePadding="@dimen/space_ms"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_ms"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_ms"
                android:text="@string/notify_warning"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/warn" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Dock ===== -->

    <com.example.quapp.TearLineView
        android:id="@+id/notify_tear"
        android:layout_width="0dp"
        android:layout_height="@dimen/tear_line_width"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintBottom_toTopOf="@id/notify_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/notify_dock"
        style="@style/Widget.Quapp.Dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notify_allow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="@string/notify_allow"
            app:icon="@drawable/ic_bell_ring"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notify_not_now"
            style="@style/Widget.Quapp.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/notify_not_now" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
