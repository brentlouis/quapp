<?xml version="1.0" encoding="utf-8"?>
<!-- One receipt slip row: LABEL ········ value (DESIGN.md section 5). ReceiptSlip adds these. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/slip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Served" />

    <com.example.quapp.TearLineView
        android:layout_width="0dp"
        android:layout_height="@dimen/tear_line_width"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_weight="1"
        app:tearColor="?attr/colorOutline"
        app:tearStyle="dotted" />

    <TextView
        android:id="@+id/slip_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceStatSmall"
        tools:text="20" />
</LinearLayout>
