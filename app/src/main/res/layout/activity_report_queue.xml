<?xml version="1.0" encoding="utf-8"?>
<!-- Report a queue (canvas 54). A form, so plain paper: the queue it's about, four reasons as
     radio rows, optional details, and a note that the reporter stays anonymous. Opened from
     the join flow (Queue detail, Join, the ticket), so it always knows the queue. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App bar -->
    <ImageButton
        android:id="@+id/report_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/report_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:accessibilityHeading="true"
        android:text="@string/report_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintBottom_toBottomOf="@id/report_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/report_back"
        app:layout_constraintTop_toTopOf="@id/report_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/report_tear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/report_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- Which queue this is about -->
            <TextView
                android:id="@+id/report_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Purok 3 Rice Sharing · Purok 3 Youth Volunteers" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:accessibilityHeading="true"
                android:text="@string/report_reason_label"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <!-- Filled with radio rows (view_option_row) in code -->
            <LinearLayout
                android:id="@+id/report_reasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/report_reason_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/report_reason_error"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/report_details_input"
                android:text="@string/report_details_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/report_details_layout"
                style="@style/Widget.Quapp.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/report_details_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_note"
                android:drawablePadding="@dimen/space_ms"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_ms"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_ms"
                android:text="@string/report_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Dock ===== -->

    <com.example.quapp.TearLineView
        android:id="@+id/report_tear"
        android:layout_width="0dp"
        android:layout_height="@dimen/tear_line_width"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintBottom_toTopOf="@id/report_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/report_dock"
        style="@style/Widget.Quapp.Dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_send"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="@string/report_send"
            app:icon="@drawable/ic_flag"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
