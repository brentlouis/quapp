<?xml version="1.0" encoding="utf-8"?>
<!-- One person in the line on the Live console. Plain row: the number in a sunk tile, the name,
     the masked phone, a Walk-in tag, and a menu for acting out of turn. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/waiting_number"
        android:layout_width="@dimen/console_lead_width"
        android:layout_height="@dimen/console_lead_height"
        android:background="@drawable/bg_tile"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceStatSmall"
        tools:text="#24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_ms"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/waiting_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Ben Cruz" />

        <TextView
            android:id="@+id/waiting_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="0917 ••• 0003" />
    </LinearLayout>

    <TextView
        android:id="@+id/waiting_tag"
        style="@style/Widget.Quapp.Tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/console_walk_in_label"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/waiting_actions"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/console_ticket_actions_description"
        android:src="@drawable/ic_more_vert"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
