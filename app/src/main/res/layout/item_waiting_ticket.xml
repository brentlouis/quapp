<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/waiting_number"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tile"
            android:gravity="start|center_vertical"
            android:textAppearance="?attr/textAppearanceStatSmall"
            tools:text="#24"
            android:layout_weight="1"
            android:minHeight="@dimen/console_lead_height"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm" />
        <ImageButton
            android:id="@+id/waiting_actions"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/console_ticket_actions_description"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/space_xs">
        <TextView
            android:id="@+id/waiting_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Ben Cruz" />
        <TextView
            android:id="@+id/waiting_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="0917 ••• 0003" />
    </LinearLayout>
    <TextView
        android:id="@+id/waiting_tag"
        style="@style/Widget.Quapp.Tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/console_walk_in_label"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="@dimen/space_xs" />
</LinearLayout>
