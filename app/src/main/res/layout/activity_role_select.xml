<?xml version="1.0" encoding="utf-8"?>
<!-- Role Select (canvas 03): two cards, one per side of the app. Each is a card because it's
     a discrete thing you tap. No back arrow: you arrive here fresh from signing up. -->
<!-- Phase 2A visual layer only: native role actions are intentionally retained. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/role_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
<include android:id="@+id/role_brand" layout="@layout/view_brand"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/phase2a_welcome_eyebrow" android:textAppearance="?attr/textAppearanceLabelSmall" android:textColor="?attr/colorOnSurfaceVariant"/>
<TextView android:id="@+id/role_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:accessibilityHeading="true" android:text="@string/phase2a_welcome_heading" android:textAppearance="?attr/textAppearanceHeadlineMedium"/>
<TextView android:id="@+id/role_subheading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/phase2a_welcome_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"/>
<com.google.android.material.card.MaterialCardView style="@style/Widget.Quapp.Card" android:theme="@style/ThemeOverlay.Quapp.Spotlight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" app:cardBackgroundColor="@color/spotlight">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/phase2a_guide_title" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/phase2a_guide_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/role_queuer_card" style="@style/Widget.Quapp.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_ms" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorPrimary"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:orientation="vertical" android:padding="@dimen/space_md"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/role_queuer_title" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnPrimary"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/role_queuer_description" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnPrimary"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/role_owner_card" style="@style/Widget.Quapp.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_ms" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurfaceContainer"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:orientation="vertical" android:padding="@dimen/space_md"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/role_owner_title" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/role_owner_description" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:paddingBottom="@dimen/space_md" android:text="@string/phase2a_demo_notice" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
