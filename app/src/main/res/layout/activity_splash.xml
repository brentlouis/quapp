<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (canvas 00): the ticket mark is centered while the app loads.
     No background: the theme's paper-and-grain window background shows through. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg">

    <ImageView
        android:id="@+id/splash_mark"
        android:layout_width="@dimen/splash_mark_width"
        android:layout_height="@dimen/splash_mark_height"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_quapp_mark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
