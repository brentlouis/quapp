<?xml version="1.0" encoding="utf-8"?>
<!-- Called (canvas 09): the one loud moment. The Activity runs in Theme.Quapp.Called, so the
     whole ground is espresso and every ?attr colour below resolves to its spotlight version.
     The number and "I'm here" are marigold (signal), which only ever appears on espresso. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/called_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App bar -->
    <ImageButton
        android:id="@+id/called_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ticket_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/called_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/called_back"
        app:layout_constraintTop_toTopOf="@id/called_back">

        <TextView
            android:id="@+id/called_queue_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Barangay Relief Distribution" />

        <TextView
            android:id="@+id/called_venue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Brgy. Poblacion Hall" />
    </LinearLayout>

    <!-- The call -->
    <TextView
        android:id="@+id/called_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_md"
        android:accessibilityLiveRegion="assertive"
        android:text="@string/called_heading"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/called_back" />

    <TextView
        android:id="@+id/called_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_md"
        android:text="@string/called_instruction"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/called_heading" />

    <TextView
        android:id="@+id/called_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_md"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTicketNumberCalled"
        android:textColor="@color/signal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/called_instruction"
        tools:text="#43" />

    <!-- ===== Bottom: the timer and "I'm here" ===== -->

    <LinearLayout
        android:id="@+id/called_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_ms"
        android:background="@drawable/bg_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_ms"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_ms"
        app:layout_constraintBottom_toTopOf="@id/called_here_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/called_ring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:max="1000"
            app:indicatorColor="@color/signal"
            app:indicatorSize="@dimen/grace_ring_size"
            app:trackColor="?attr/colorSurfaceVariant"
            app:trackThickness="@dimen/grace_ring_thickness" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_ms"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/called_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceStatHero"
                tools:text="2:14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/called_timer_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/called_here_button"
        style="@style/Widget.Quapp.Button.Call"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_xl"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:text="@string/ticket_here_action"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toTopOf="@id/called_move_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Not there yet: move back instead of losing the slot (canvas 09, opens the sheet from 28) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/called_move_back"
        style="@style/Widget.Quapp.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_ms"
        android:layout_marginEnd="@dimen/space_md"
        android:text="@string/called_move_back_action"
        app:layout_constraintBottom_toTopOf="@id/called_move_back_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/called_move_back_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:gravity="center_horizontal"
        android:text="@string/called_move_back_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
