<?xml version="1.0" encoding="utf-8"?>
<!-- Share queue (canvas 31), from the console's options sheet. The QR card is plain raised
     paper (it's printed and posted, not a ticket), then the link, then the dock. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/share_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App bar -->
    <ImageButton
        android:id="@+id/share_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/share_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:accessibilityHeading="true"
        android:text="@string/share_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintBottom_toBottomOf="@id/share_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/share_back"
        app:layout_constraintTop_toTopOf="@id/share_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/share_tear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/share_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share_lead"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- What goes on the poster: name, QR, one line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/share_queue_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    tools:text="Free Medical Mission" />

                <ImageView
                    android:id="@+id/share_qr"
                    android:layout_width="@dimen/share_qr_size"
                    android:layout_height="@dimen/share_qr_size"
                    android:layout_marginTop="@dimen/space_md"
                    android:contentDescription="@string/share_qr_description" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_horizontal"
                    android:text="@string/share_scan"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <!-- The link, with Copy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/share_link_label"
                android:textAppearance="?attr/textAppearanceFieldLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:minHeight="@dimen/field_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_xs">

                <TextView
                    android:id="@+id/share_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="quapp.app/q/free-medical-mission" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share_copy"
                    style="@style/Widget.Quapp.Button.Text.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_copy"
                    app:icon="@drawable/ic_copy" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Dock ===== -->

    <com.example.quapp.TearLineView
        android:id="@+id/share_tear"
        android:layout_width="0dp"
        android:layout_height="@dimen/tear_line_width"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        app:layout_constraintBottom_toTopOf="@id/share_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/share_dock"
        style="@style/Widget.Quapp.Dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_send"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:text="@string/share_send"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_counter"
            style="@style/Widget.Quapp.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/share_counter"
            app:icon="@drawable/ic_monitor"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
