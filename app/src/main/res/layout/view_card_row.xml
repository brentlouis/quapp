<?xml version="1.0" encoding="utf-8"?>
<!-- One line of a catalogue card: the label on the left, the value on the right, written on a
     ruled line. QueueCards.row fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="@dimen/card_row_height"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/row_label"
        android:minWidth="@dimen/card_label_width"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Where" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:gravity="start"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Brgy. Poblacion Hall · Within 1 km" />
</LinearLayout>
