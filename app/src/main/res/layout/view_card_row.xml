<?xml version="1.0" encoding="utf-8"?>
<!-- One line of a catalogue card: the label on the left, the value on the right, written on a
     ruled line. QueueCards.row fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ruled_row"
    android:baselineAligned="true"
    android:minHeight="@dimen/card_row_height"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Where" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Brgy. Poblacion Hall · Within 1 km" />
</LinearLayout>
