<?xml version="1.0" encoding="utf-8"?>
<!-- A numbered step: the ringed number, a title and a line of explanation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_ms"
    android:paddingBottom="@dimen/space_ms">

    <TextView
        android:id="@+id/step_number"
        android:layout_width="@dimen/forgot_step_size"
        android:layout_height="@dimen/forgot_step_size"
        android:background="@drawable/bg_step_number"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_ms"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Create a queue" />

        <TextView
            android:id="@+id/step_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Name, venue, hours and the checks you want." />
    </LinearLayout>
</LinearLayout>
