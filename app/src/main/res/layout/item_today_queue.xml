<?xml version="1.0" encoding="utf-8"?>
<!-- One queue on the Today tab. A plain row, not a card; tapping opens that queue's Insights. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/today_row_name"
        android:drawablePadding="@dimen/space_sm"
        app:drawableEndCompat="@drawable/ic_chevron_right"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        tools:text="Free Medical Mission" />

    <TextView
        android:id="@+id/today_row_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="1 no-show · 1.3 min per person" />

    <TextView
        android:id="@+id/today_row_served"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceStat"
        tools:text="20" />

    <TextView
        android:id="@+id/today_row_served_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_row_served"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/today_row_chevron"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="@dimen/space_sm"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
