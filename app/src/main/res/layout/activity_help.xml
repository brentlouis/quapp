<?xml version="1.0" encoding="utf-8"?>
<!-- Help and support (canvas 49), from Profile. Plain paper: two groups of rows and a note.
     The "how it works" rows open a sheet each; the others leave the app (email) or report. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/help_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App bar -->
    <ImageButton
        android:id="@+id/help_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_xs"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/help_back_description"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_md"
        android:accessibilityHeading="true"
        android:text="@string/help_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintBottom_toBottomOf="@id/help_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/help_back"
        app:layout_constraintTop_toTopOf="@id/help_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/help_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- How Quapp works -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/help_section_how"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <include
                android:id="@+id/help_queues_row"
                layout="@layout/view_list_row" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/help_checks_row"
                layout="@layout/view_list_row" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/help_moving_row"
                layout="@layout/view_list_row" />

            <!-- Get help -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/help_section_get_help"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <include
                android:id="@+id/help_email_row"
                layout="@layout/view_list_row" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/help_report_row"
                layout="@layout/view_list_row" />

            <!-- Something wrong while in line: the number still works -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_note"
                android:drawablePadding="@dimen/space_ms"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_ms"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_ms"
                android:text="@string/help_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
