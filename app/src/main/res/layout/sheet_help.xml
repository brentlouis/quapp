<?xml version="1.0" encoding="utf-8"?>
<!-- One help topic from Help and support (canvas 49): a title and a few short paragraphs. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/help_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            tools:text="How queues work" />

        <TextView
            android:id="@+id/help_sheet_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_ms"
            android:lineSpacingExtra="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Find a queue on Browse and tap Join." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
