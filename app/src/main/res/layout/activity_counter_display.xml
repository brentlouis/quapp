<?xml version="1.0" encoding="utf-8"?>
<!-- Public display: a full-width serving card; scrolling keeps long snapshots and QR reachable. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Quapp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/spotlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/counter_serving_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/counter_now_serving"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/paper_raised" />

                <TextView
                    android:id="@+id/counter_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:autoSizeMaxTextSize="@dimen/type_44_sp"
                    android:autoSizeMinTextSize="@dimen/type_20_sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTicketNumber"
                    android:textColor="@color/paper_raised"
                    tools:text="#23" />

                <TextView
                    android:id="@+id/counter_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/paper_raised"
                    tools:text="@string/counter_come_up" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/counter_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/ink_muted"
            tools:text="Free Medical Mission · 8 waiting" />

        <TextView
            android:id="@+id/counter_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:accessibilityHeading="true"
            android:text="@string/counter_up_next"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/ink_muted" />

        <TextView
            android:id="@+id/counter_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/ink"
            tools:text="#24   #25   #26" />

        <FrameLayout
            android:id="@+id/counter_qr_plate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_qr_plate"
            android:padding="@dimen/space_ms">

            <ImageView
                android:id="@+id/counter_qr"
                android:layout_width="@dimen/counter_qr_size"
                android:layout_height="@dimen/counter_qr_size"
                android:contentDescription="@string/share_qr_description" />
        </FrameLayout>

        <TextView
            android:id="@+id/counter_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ink_muted"
            tools:text="Scan to join from your phone, or search &quot;Free Medical Mission&quot; in Quapp." />
        <TextView android:id="@+id/counter_announcement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/ink" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
