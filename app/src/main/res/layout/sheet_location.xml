<?xml version="1.0" encoding="utf-8"?>
<!-- Check that you're nearby (canvas 44): shown before Android's own permission dialog, so the
     queuer knows why Quapp asks and that it only looks once. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/location_sheet_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/location_sheet_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="This queue only takes people within 1 km of Brgy. Poblacion Hall, so spots go to people who can actually show up." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:drawablePadding="@dimen/space_ms"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/location_sheet_once"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:drawableStartCompat="@drawable/ic_map_pin"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/space_ms"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/location_sheet_not_tracked"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:drawableStartCompat="@drawable/ic_block"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/location_sheet_allow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_lg"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/location_sheet_allow"
        app:icon="@drawable/ic_navigation"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/location_sheet_not_now"
        style="@style/Widget.Quapp.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/location_sheet_not_now" />
</LinearLayout>
